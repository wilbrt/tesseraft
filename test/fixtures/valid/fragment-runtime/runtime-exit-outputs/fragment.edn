{:api-version "tesseraft.fragment/v1"
 :kind :fragment
 :metadata {:name "runtime-exit-outputs" :title "Runtime exit-output projection fixture" :version "0.1.0"}
 :interface {:outputs {:status {:required true}}
             :outcomes #{:pass}}
 :assets {:scripts ["./scripts/write.py"]}
 :fragment {:initial :write
            :exit [{:on :pass :produces {:status "artifacts/status.json"}}]
            :states {:write {:type :process
                             :command ["./scripts/write.py"]
                             :outputs {:status {:path "artifacts/status.json" :required true}}
                             :transitions [{:when {:status "pass"} :next :done}]}
                     :done {:type :terminal :status :success :outcome :pass}}}}
