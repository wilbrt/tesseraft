{:api-version "tesseraft.fragment/v1"
 :kind :fragment
 :metadata {:name "runtime-mock-agent" :title "Runtime mock-agent fixture" :version "0.1.0"}
 :interface {:outputs {:status {:required true}}
             :outcomes #{:pass}}
 :assets {:prompts ["prompts/execute.md.tmpl"]}
 :fragment {:initial :execute
            :exit [{:on :pass :produces {:status "status.json"}}]
            :states {:execute {:type :agent
                               :executor :pi-cli
                               :prompt-template "prompts/execute.md.tmpl"
                               :outputs {:status {:path "status.json" :required true}}
                               :transitions [{:when {:status "pass"} :next :done}]}
                     :done {:type :terminal :status :success :outcome :pass}}}}
