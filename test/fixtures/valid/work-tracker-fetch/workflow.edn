{:api-version "tesseraft.workflow/v1"
 :kind :workflow
 :metadata {:name "work-tracker-fetch-fixture"}
 :inputs {:item-id {:type :string :required true}}
 :defaults {:max-rounds 1 :state-timeout "1m"}
 :policies {:require-timeouts true
            :require-max-rounds true}
 :initial :fetch
 :states
 {:fetch
  {:type :deterministic
   :handler :work-tracker/fetch-item
   :runtime {:timeout "10s"}
   :inputs {:item-id "{{inputs.item-id}}"}
   :outputs {:work-item {:path "work-tracker/item.json"
                         :schema "../../../../schemas/normalized-work-item.schema.json"
                         :required true}}
   :next :done}
  :done {:type :terminal :status :success}}}
