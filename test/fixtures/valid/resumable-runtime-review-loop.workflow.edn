{:api-version "tesseraft.workflow/v1"
 :kind :workflow
 :metadata {:name "resumable-runtime-review-loop"
            :title "Resumable runtime review loop fixture"}
 :inputs {:prompt {:type :string :required true}}
 :defaults {:max-rounds 3 :state-timeout "1m"}
 :policies {:require-timeouts true :require-max-rounds true}
 :initial :implement
 :states
 {:implement
  {:type :agent
   :executor :pi-cli
   :prompt-template "prompts/resumable-runtime-initial.md.tmpl"
   :prompt-output "prompts/generated/implement-initial-{{run.attempt}}.md"
   :session
   {:mode :resumable
    :continuation-prompt-template "prompts/resumable-runtime-continuation.md.tmpl"
    :continuation-prompt-output "prompts/generated/implement-continuation-{{run.attempt}}.md"}
   :tools [:read :bash :edit :write :grep :find :ls]
   :runtime {:timeout "1m"}
   :outputs
   {:status {:path "execution/implement-status-{{run.attempt}}.json"
             :required true}
    :summary {:path "execution/implement-summary-{{run.attempt}}.md"
              :required true}}
   :transitions [{:when {:status "pass"} :next :review}]}

  :review
  {:type :process
   :command ["scripts/resumable-review.py"]
   :runtime {:timeout "1m"}
   :transitions
   [{:when {:status "fail"}
     :effects [:merge-issues :inc-round]
     :next :implement}
    {:when {:status "pass"} :next :done}]}

  :done
  {:type :terminal :status :success}}}
