{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tesseraft Work Tracker Connection",
  "description": "Optional project-owned work tracker envelope. Omit connections.work-tracker when the project has no tracker. The supported provider set is closed until Tesseraft has executable, trusted plugin loading.",
  "type": "object",
  "required": ["provider", "credential-ref", "config"],
  "properties": {
    "provider": { "enum": ["plane", "jira", "github-issues"] },
    "schema-version": { "const": 1 },
    "credential-ref": { "$ref": "credential-ref.schema.json" },
    "config": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "provider": { "const": "plane" } }, "required": ["provider"] },
      "then": { "properties": { "config": { "$ref": "work-tracker-plane.schema.json" } } }
    },
    {
      "if": { "properties": { "provider": { "const": "jira" } }, "required": ["provider"] },
      "then": { "properties": { "config": { "$ref": "work-tracker-jira.schema.json" } } }
    },
    {
      "if": { "properties": { "provider": { "const": "github-issues" } }, "required": ["provider"] },
      "then": { "properties": { "config": { "$ref": "work-tracker-github-issues.schema.json" } } }
    }
  ],
  "additionalProperties": false
}
