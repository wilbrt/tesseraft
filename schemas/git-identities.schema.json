{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tesseraft Git Identities",
  "type": "object",
  "required": ["version", "projects"],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "version": { "const": 1 },
    "default": { "$ref": "#/$defs/identity" },
    "projects": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
      "additionalProperties": { "$ref": "#/$defs/identity" }
    }
  },
  "additionalProperties": false
}
