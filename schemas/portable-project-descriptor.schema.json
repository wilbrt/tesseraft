{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tesseraft Portable Project Descriptor v2",
  "description": "Repository-owned project identity and portable configuration stored at .tesseraft/project.json.",
  "type": "object",
  "required": ["version", "project_id"],
  "properties": {
    "version": { "const": 2 },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "name": { "type": "string" },
    "runs_root": { "type": "string" },
    "discovery": {
      "type": "object",
      "properties": {
        "workflow_roots": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "connections": {
      "type": "object",
      "properties": {
        "code-host": {
          "type": "object",
          "required": ["provider", "auth-mode"],
          "properties": {
            "provider": { "const": "github" },
            "auth-mode": { "enum": ["credential-ref", "ambient"] },
            "credential-ref": { "$ref": "credential-ref.schema.json" }
          },
          "allOf": [
            {
              "if": { "properties": { "auth-mode": { "const": "credential-ref" } } },
              "then": { "required": ["credential-ref"] },
              "else": { "not": { "required": ["credential-ref"] } }
            }
          ],
          "additionalProperties": false
        },
        "work-tracker": { "$ref": "work-tracker.schema.json" }
      },
      "additionalProperties": false
    },
    "runtime_defaults": {
      "type": "object",
      "properties": {
        "default_executor": { "type": "string" },
        "executor_mode": { "enum": ["live", "mock"] }
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "properties": {
        "source_version": { "type": "integer" },
        "source_sha256": { "type": "string" },
        "tool_version": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
