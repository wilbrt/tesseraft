{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tesseraft User-local Project Registry v2",
  "description": "Machine-local project ID to canonical local root mapping stored under $TESSERAFT_HOME/projects/registry.json.",
  "type": "object",
  "required": ["version", "projects"],
  "properties": {
    "version": { "const": 2 },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["workspace_root"],
        "properties": {
          "workspace_root": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "last_seen_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
