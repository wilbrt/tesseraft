{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Work Item",
  "type": "object",
  "required": ["schema_version", "provider", "project", "remote", "identifier", "title", "description", "state", "priority", "assignees", "labels", "fetched_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "type": "string", "enum": ["plane", "jira", "github-issues"] },
    "project": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "remote": {
      "type": "object",
      "required": ["id", "identifier"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "identifier": { "type": "string", "minLength": 1 },
        "workspace_slug": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "project_key": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" }
      },
      "oneOf": [
        { "required": ["workspace_slug", "project_id"], "not": { "anyOf": [{ "required": ["project_key"] }, { "required": ["repository"] }] } },
        { "required": ["project_key"], "not": { "anyOf": [{ "required": ["workspace_slug"] }, { "required": ["project_id"] }, { "required": ["repository"] }] } },
        { "required": ["repository"], "not": { "anyOf": [{ "required": ["workspace_slug"] }, { "required": ["project_id"] }, { "required": ["project_key"] }] } }
      ],
      "additionalProperties": false
    },
    "identifier": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "state": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "priority": { "type": "string", "enum": ["urgent", "high", "medium", "low", "none"] },
    "assignees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string" },
          "email": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          { "required": ["id"] },
          { "required": ["name"] }
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "color": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "url": { "type": ["string", "null"] },
    "fetched_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "provider": { "const": "plane" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "remote": {
            "required": ["workspace_slug", "project_id"],
            "not": { "anyOf": [{ "required": ["project_key"] }, { "required": ["repository"] }] }
          }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "jira" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "remote": {
            "required": ["project_key"],
            "not": { "anyOf": [{ "required": ["workspace_slug"] }, { "required": ["project_id"] }, { "required": ["repository"] }] }
          }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "github-issues" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "remote": {
            "required": ["repository"],
            "not": { "anyOf": [{ "required": ["workspace_slug"] }, { "required": ["project_id"] }, { "required": ["project_key"] }] }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
