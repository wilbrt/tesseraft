{:api-version "tesseraft.workflow/v1"
 :kind :workflow
 :metadata {:name "design-in-practice-to-pr"
            :title "Design in Practice to PR"
            :description "Turn a prompt into a problem-grounded design, isolated implementation, tiered deterministic validation, independent review, and pull request with bounded evidence-driven correction."}
 :inputs {:prompt {:type :string :required true}
          :repo-root {:type :path :required true}
          :base-branch {:type :string :default "main"}
          :branch {:type :string :required false}}
 :defaults {:max-rounds 12
            :state-timeout "45m"
            :approval-timeout "24h"
            :base-branch "main"}
 :policies {:runtime-cannot-edit-workflow true
            :authoring-cannot-edit-runs true
            :require-timeouts true
            :require-max-rounds true
            :require-status-output-for-agent-nodes true
            :forbid-inline-secrets true
            :allowed-agent-tools [:read :bash :edit :write :grep :find :ls]}
 :initial :collect-prompt
 :states
 {:collect-prompt
  {:type :process
   :title "Collect prompt"
   :command ["./scripts/collect_prompt.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30s"}
   :outputs {:prompt-json {:path "prompt/prompt.json" :required true}
             :prompt-md {:path "prompt/prompt.md" :required true}}
   :next :collect-context}

  :collect-context
  {:type :process
   :title "Collect bounded repository context"
   :command ["./scripts/collect_context.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30s"}
   :outputs {:repository-context {:path "context/repository.json" :required true}
             :prior-run-lessons {:path "context/prior-run-lessons.md" :required true}}
   :next :design}

  :design
  {:type :agent
   :title "Describe, diagnose, delimit, choose direction, and design"
   :executor :pi-cli
   :provider "opencode-go"
   :model "kimi-k3"
   :thinking "high"
   :prompt-template "prompts/design.md.tmpl"
   :prompt-output "prompts/generated/design-{{run.attempt}}.md"
   :session-name "design-in-practice-design-{{run.attempt}}"
   :tools [:read :bash :grep :find :ls :write]
   :runtime {:cwd "{{inputs.repo-root}}" :timeout "45m"}
   :outputs {:status {:path "design/status-{{run.attempt}}.json" :schema "../../../schemas/status.schema.json" :required true}
             :brief {:path "design/brief.md" :required true}
             :validation-plan {:path "design/validation-plan.json" :schema "schemas/validation-plan.schema.json" :required true}
             :branch-name {:path "design/branch-name.txt" :required true}
             :pr-title {:path "design/pr-title.txt" :required true}}
   :transitions [{:when {:status "pass"} :next :check-design}
                 {:when {:status "fail"} :effects [:inc-round] :next :design}]}

  :check-design
  {:type :process
   :title "Validate compact design contract"
   :command ["./scripts/check_design.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30s"}
   :outputs {:report {:path "design/check-current.json" :required true}}
   :transitions [{:when {:status "pass"} :next :ensure-worktree}
                 {:when {:status "fail"} :effects [:inc-round] :next :design}]}

  :ensure-worktree
  {:type :deterministic
   :title "Create isolated implementation worktree"
   :handler :git/ensure-worktree
   :runtime {:timeout "5m"}
   :inputs {:branch-file "design/branch-name.txt"}
   :outputs {:worktree-path {:path "worktree/path.txt" :required true}}
   :next :implement}

  :implement
  {:type :agent
   :title "Implement or correct current evidence"
   :executor :pi-cli
   :provider "opencode-go"
   :model "kimi-k2.7-code"
   :prompt-template "prompts/implement.md.tmpl"
   :prompt-output "prompts/generated/implement-{{run.round}}.md"
   :session-name "design-in-practice-implement-{{run.round}}"
   :tools [:read :bash :edit :write :grep :find :ls]
   :runtime {:cwd "{{run.worktree-dir}}" :timeout "90m"}
   :outputs {:status {:path "execution/status-{{run.round}}.json" :schema "../../../schemas/status.schema.json" :required true}
             :summary {:path "execution/summary-{{run.round}}.md" :required true}
             :issues {:path "execution/issues-{{run.round}}.json" :schema "../../../schemas/issues.schema.json" :required false}}
   :transitions [{:when {:status "pass"} :next :validate}
                 {:when {:status "fail"} :effects [:inc-round] :next :prepare-feedback}]}

  :validate
  {:type :process
   :title "Run tiered deterministic validation"
   :command ["./scripts/run_validation.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "2h"}
   :outputs {:report {:path "validation/report-{{run.round}}.md" :required true}
             :summary {:path "validation/summary-{{run.round}}.json" :required true}
             :issues {:path "validation/issues-{{run.round}}.json" :schema "../../../schemas/issues.schema.json" :required false}}
   :transitions [{:when {:status "pass"} :next :review}
                 {:when {:status "fail"} :effects [:inc-round] :next :prepare-feedback}]}

  :review
  {:type :agent
   :title "Independently review the complete current diff"
   :executor :pi-cli
   :provider "opencode-go"
   :model "kimi-k3"
   :thinking "high"
   :prompt-template "prompts/review.md.tmpl"
   :prompt-output "prompts/generated/review-{{run.round}}.md"
   :session-name "design-in-practice-review-{{run.round}}"
   :tools [:read :bash :grep :find :ls :write]
   :runtime {:cwd "{{run.worktree-dir}}" :timeout "45m"}
   :outputs {:status {:path "review/status-{{run.round}}.json" :schema "../../../schemas/status.schema.json" :required true}
             :report {:path "review/report-{{run.round}}.md" :required true}
             :issues {:path "review/issues-{{run.round}}.json" :schema "../../../schemas/issues.schema.json" :required false}}
   :transitions [{:when {:status "pass"} :next :assemble-pr}
                 {:when {:status "fail"} :effects [:inc-round] :next :prepare-feedback}]}

  :prepare-feedback
  {:type :process
   :title "Select current feedback and assess progress"
   :command ["./scripts/prepare_feedback.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30s"}
   :inputs {:correction-budget 8}
   :outputs {:current {:path "feedback/current.json" :required true}
             :history {:path "feedback/history.json" :required true}}
   :transitions [{:when {:route "continue"} :next :implement}
                 {:when {:route "supervise"} :next :supervisor}
                 {:when {:route "intervene"} :next :intervention}]}

  :supervisor
  {:type :agent
   :title "Inspect stalled correction evidence"
   :executor :pi-cli
   :provider "opencode-go"
   :model "kimi-k3"
   :thinking "high"
   :prompt-template "prompts/supervisor.md.tmpl"
   :prompt-output "prompts/generated/supervisor-{{run.round}}.md"
   :session-name "design-in-practice-supervisor-{{run.round}}"
   :tools [:read :grep :find :ls :write]
   :runtime {:cwd "{{inputs.repo-root}}" :timeout "45m"}
   :outputs {:status {:path "supervision/status-{{run.round}}.json" :schema "../../../schemas/status.schema.json" :required true}
             :report {:path "supervision/report-{{run.round}}.md" :required true}
             :current {:path "supervision/current.json" :required true}}
   :next :check-supervision}

  :check-supervision
  {:type :process
   :title "Validate compact supervision handoff"
   :command ["./scripts/check_supervision.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30s"}
   :transitions [{:when {:route "continue"} :next :implement}
                 {:when {:route "intervene"} :next :intervention}]}

  :intervention
  {:type :approval
   :title "Correction loop needs direction"
   :message "Repeated evidence is not converging. Retry with the preserved evidence or stop this run."
   :artifact {:path "feedback/current.json" :kind "feedback"}
   :presentation {:question "Should this run retry from the current evidence or stop?"
                  :artifacts [{:path "feedback/current.json" :kind "feedback"}]
                  :decisions [{:decision "retry" :label "Retry" :consequence "Return to implementation with current supervision."}
                              {:decision "stop" :label "Stop" :consequence "Record run learning and end without creating a PR." :intent :danger :requires-message true}]
                  :routing {:kind :self}}
   :transitions [{:when {:decision "retry"} :next :implement}
                 {:when {:decision "stop"} :next :record-learning}]}

  :assemble-pr
  {:type :process
   :title "Assemble pull request metadata"
   :command ["./scripts/assemble_pr.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30s"}
   :outputs {:title {:path "pr/pr-title.txt" :required true}
             :body {:path "pr/pr-body.md" :required true}}
   :next :create-pr}

  :create-pr
  {:type :deterministic
   :title "Create pull request"
   :handler :github/create-pr
   :runtime {:cwd "{{run.worktree-dir}}" :timeout "5m" :requires-secrets [:github-token]}
   :inputs {:title-file "pr/pr-title.txt"
            :body-file "pr/pr-body.md"
            :branch-file "design/branch-name.txt"
            :repo-dir-file "worktree/path.txt"}
   :outputs {:pr-json {:path "pr/pr.json" :required true}}
   :next :record-learning}

  :record-learning
  {:type :process
   :title "Record deterministic run learning"
   :command ["./scripts/record_learning.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30s"}
   :outputs {:summary {:path "learning/run-summary.json" :required true}}
   :transitions [{:when {:pr_created true} :next :done}
                 {:when {:pr_created false} :effects [:fail-run] :next :halted}]}

  ;; The run is already failed before this router can execute. Keeping the
  ;; state non-terminal prevents finish-if-terminal from rewriting an operator
  ;; stop as a successful terminal run.
  :halted
  {:type :router
   :title "Stopped without PR"
   :next :done}

  :done
  {:type :terminal
   :title "Done"
   :status :success}}}
