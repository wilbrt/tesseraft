{:api-version "tesseraft.workflow/v1"
 :kind :workflow
 :metadata {:name "supervised-deterministic-code-review-loop"
            :title "Supervised Deterministic Code Review Loop"
            :description "The deterministic code review loop with an independent, read-only supervisor checkpoint after every three failed correction cycles. Deterministic bb and Playwright gates retain test authority; the supervisor inspects durable run evidence and writes direction for the next implementation attempt."}
 :inputs {:prompt {:type :string :required true}
          :repo-root {:type :path :required true}
          :base-branch {:type :string :default "main"}
          :branch {:type :string :required false}}
 :defaults {:max-rounds 100
            :state-timeout "45m"
            :base-branch "main"}
 :policies {:require-timeouts true
            :require-max-rounds true
            :require-status-output-for-agent-nodes true
            :forbid-inline-secrets true
            :allowed-agent-tools [:read :bash :edit :write :grep :find :ls]}
 :initial :collect-prompt
 :states
 {:collect-prompt
  {:type :process
   :title "Collect prompt"
   :command ["./scripts/collect_prompt.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30s"}
   :outputs {:prompt-json {:path "prompt/prompt.json" :required true}
             :prompt-md {:path "prompt/prompt.md" :required true}}
   :next :design}

  :design
  {:type :agent
   :title "Design"
   :executor :pi-cli
   :provider "openai-codex"
   :model "gpt-5.6-sol"
   :thinking "medium"
   :prompt-template "prompts/design.md.tmpl"
   :prompt-output "prompts/generated/design-{{run.attempt}}.md"
   :session-name "supervised-deterministic-code-review-loop-design-{{run.attempt}}"
   :tools [:read :bash :grep :find :ls :write]
   :runtime {:cwd "{{inputs.repo-root}}" :timeout "45m"}
   :outputs {:status {:path "design/status.json" :schema "../../../schemas/status.schema.json" :required true}
             :design-doc {:path "design/design.md" :required true}
             :branch-name {:path "design/branch-name.txt" :required true}}
   :transitions [{:when {:status "pass"} :next :ensure-worktree}
                 {:when {:status "fail"} :next :design}]}

  :ensure-worktree
  {:type :deterministic
   :title "Create isolated worktree"
   :handler :git/ensure-worktree
   :runtime {:timeout "5m"}
   :inputs {:branch-file "design/branch-name.txt"}
   :outputs {:worktree-path {:path "worktree/path.txt" :required true}}
   :next :implement}

  :implement
  {:type :agent
   :title "Implement in worktree"
   :executor :pi-cli
   :provider "openai-codex"
   :model "gpt-5.5"
   :thinking "medium"
   :prompt-template "prompts/implement.md.tmpl"
   :prompt-output "prompts/generated/implement-{{run.round}}.md"
   :session-name "supervised-deterministic-code-review-loop-implement-{{run.round}}"
   :tools [:read :bash :edit :write :grep :find :ls]
   :runtime {:cwd "{{run.worktree-dir}}" :timeout "90m"}
   :outputs {:status {:path "execution/status-{{run.round}}.json" :schema "../../../schemas/status.schema.json" :required true}
             :summary {:path "execution/summary-{{run.round}}.md" :required true}
             :issues {:path "execution/issues-{{run.round}}.json" :schema "../../../schemas/issues.schema.json" :required false}}
   :transitions [{:when {:status "pass"} :next :bb-test-gate}
                 {:when {:status "fail"} :effects [:merge-issues :inc-round] :next :supervision-check}]}

  ;; All failed correction cycles pass through this cheap cadence check. Since
  ;; runs start at round 1, rounds 4, 7, 10, ... represent each third failure.
  :supervision-check
  {:type :process
   :title "Check periodic supervision cadence"
   :command ["./scripts/check_supervision.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30s"}
   :transitions [{:when {:route "supervise"} :next :supervisor}
                 {:when {:route "continue"} :next :implement}]}

  :supervisor
  {:type :agent
   :title "Inspect correction-loop progress"
   :executor :pi-cli
   :provider "openai-codex"
   :model "gpt-5.6-sol"
   :thinking "medium"
   :prompt-template "prompts/supervisor.md.tmpl"
   :prompt-output "prompts/generated/supervisor-{{run.round}}.md"
   :session-name "supervised-deterministic-code-review-loop-supervisor-{{run.round}}"
   :tools [:read :grep :find :ls :write]
   :runtime {:cwd "{{inputs.repo-root}}" :timeout "45m"}
   :outputs {:status {:path "supervision/status-{{run.round}}.json" :schema "../../../schemas/status.schema.json" :required true}
             :report {:path "supervision/report-{{run.round}}.md" :required true}
             :current {:path "supervision/current.md" :required true}}
   :transitions [{:when {:status "pass"} :next :implement}
                 {:when {:status "fail"} :next :implement}]}

  ;; ---- Deterministic gate 1: bb test (cheap, fast) ----
  ;; Runs `bb test` in the implementation worktree. Runs first so a fast
  ;; failure loops back to :implement WITHOUT burning a 25-minute Playwright
  ;; run on already-broken code. Expected test failures -> exit 0 with
  ;; status="fail" + issues file; a runner/crash fault -> nonzero exit, which
  ;; tesseraft records as an external failure rather than a test result.
  :bb-test-gate
  {:type :process
   :title "Run deterministic bb test suite"
   :command ["./scripts/run_bb_test.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "15m"}
   :outputs {:report {:path "bb-test/report-{{run.round}}.md" :required true}
             :issues {:path "bb-test/issues-{{run.round}}.json" :schema "../../../schemas/issues.schema.json" :required false}}
   :transitions [{:when {:status "pass"} :next :playwright-gate}
                 {:when {:status "fail"} :effects [:merge-issues :inc-round] :next :supervision-check}]}

  ;; ---- Deterministic gate 2: Playwright browser suite (expensive) ----
  ;; Runs `npm run web:e2e` in the implementation worktree, but only after the
  ;; bb gate passed, so the expensive browser run is reserved for code that is
  ;; already smoke-green. Same runner/contract as the playwright-code-review-loop
  ;; example (this gates the Web UI; it is one of two deterministic test layers).
  :playwright-gate
  {:type :process
   :title "Run Playwright browser tests"
   :command ["./scripts/run_playwright.py"]
   :input-mode :json-stdin
   :output-mode :json-stdout
   :runtime {:timeout "30m"}
   :outputs {:report {:path "playwright/report-{{run.round}}.md" :required true}
             :issues {:path "playwright/issues-{{run.round}}.json" :schema "../../../schemas/issues.schema.json" :required false}}
   :transitions [{:when {:status "pass"} :next :review}
                 {:when {:status "fail"} :effects [:merge-issues :inc-round] :next :supervision-check}]}

  :review
  {:type :agent
   :title "Code review"
   :executor :pi-cli
   :provider "openai-codex"
   :model "gpt-5.6-sol"
   :thinking "medium"
   :prompt-template "prompts/review.md.tmpl"
   :prompt-output "prompts/generated/review-{{run.round}}.md"
   :session-name "supervised-deterministic-code-review-loop-review-{{run.round}}"
   :tools [:read :bash :grep :find :ls :write]
   :runtime {:cwd "{{run.worktree-dir}}" :timeout "45m"}
   :outputs {:status {:path "review/status-{{run.round}}.json" :schema "../../../schemas/status.schema.json" :required true}
             :report {:path "review/report-{{run.round}}.md" :required true}
             :issues {:path "review/issues-{{run.round}}.json" :schema "../../../schemas/issues.schema.json" :required false}}
   :transitions [{:when {:status "pass"} :effects [:clear-issues] :next :pr-draft}
                 {:when {:status "fail"} :effects [:merge-issues :inc-round] :next :supervision-check}]}

  :pr-draft
  {:type :agent
   :title "Draft PR metadata"
   :executor :pi-cli
   :provider "openai-codex"
   :model "gpt-5.6-sol"
   :thinking "medium"
   :prompt-template "prompts/pr-draft.md.tmpl"
   :prompt-output "prompts/generated/pr-draft-{{run.attempt}}.md"
   :session-name "supervised-deterministic-code-review-loop-pr-draft-{{run.attempt}}"
   :tools [:read :bash :grep :find :ls :write]
   :runtime {:cwd "{{run.worktree-dir}}" :timeout "20m"}
   :outputs {:status {:path "pr/draft-status.json" :schema "../../../schemas/status.schema.json" :required true}
             :title {:path "pr/pr-title.txt" :required true}
             :body {:path "pr/pr-body.md" :required true}}
   :transitions [{:when {:status "pass"} :next :create-pr}
                 {:when {:status "fail"} :next :pr-draft}]}

  :create-pr
  {:type :deterministic
   :title "Create pull request"
   :handler :github/create-pr
   :runtime {:cwd "{{run.worktree-dir}}" :timeout "5m" :requires-secrets [:github-token]}
   :inputs {:title-file "pr/pr-title.txt"
            :body-file "pr/pr-body.md"
            :branch-file "design/branch-name.txt"
            :repo-dir-file "worktree/path.txt"}
   :outputs {:pr-json {:path "pr/pr.json" :required true}}
   :next :done}

  :done
  {:type :terminal
   :title "Done"
   :status :success}}}