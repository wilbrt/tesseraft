{
  "name": "tesseraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "11.18.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "build:web": "tsc -p tsconfig.server.json && vite build --config web/vite.config.ts",
    "generate:types": "node scripts/generate-wire-types.mjs",
    "check:types": "node scripts/generate-wire-types.mjs --check",
    "test:node": "node --test --test-concurrency=1 test/adapter-credential-resolution.test.js test/claude-code-executor.test.js test/discovery-scope.test.js test/local-credential-migration.test.js test/project-contract.test.js test/project-root-selection.test.js test/project-scope.test.js test/runtime-redaction.test.js test/work-tracker-contract.test.js test/work-tracker-read-adapters.test.js test/work-tracker-read.test.js test/work-tracker-settings-doctor.test.js",
    "test:web": "node --import tsx --test --test-concurrency=1 test/web-*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:container": "test/container/test.sh",
    "test:all": "bb test:all",
    "test": "bb test",
    "web:build": "npm run build:web",
    "web:test": "npm run test:web",
    "web:e2e": "npm run test:e2e",
    "web:e2e:ui": "npm run test:e2e:ui"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.2",
    "express": "5.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.6",
    "@types/node": "22.18.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "agent-browser": "0.26.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
